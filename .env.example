# Copiar este archivo como .env y completar los valores. Nunca subir .env al repositorio.

# Obligatoria: clave de Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Modelo principal y de respaldo (se usa si el principal está saturado o sin cupo).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.8-flash

# Opcional: fecha (AAAA-MM-DD) para decidir si un soporte está vencido. Vacía = hoy en Colombia.
FECHA_EJECUCION=

# Opcionales: topes de costo y robustez (valores por defecto entre paréntesis).
# MAX_ITERACIONES=25        # vueltas herramienta → modelo por turno
# MAX_TOKENS_SESION=300000  # tokens por sesión de chat
# LLM_TIMEOUT_MS=60000      # espera máxima al modelo
# PORT=3000                 # Render lo define solo
